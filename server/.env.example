# Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
# DATABASE_URL: pooled connection (pgbouncer, transaction mode) used by the running app
# DIRECT_URL: direct connection (session mode) used by `prisma migrate`
DATABASE_URL="postgresql://postgres.vfosnomukioghqnyvhnc:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.vfosnomukioghqnyvhnc:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Two-Factor Authentication
TWO_FACTOR_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Logging
LOG_LEVEL=debug
